BOT_TOKEN=123456:your-telegram-bot-token
ADMIN_IDS=123456789
REDIS_URL=redis://localhost:6379/0
DATABASE_PATH=data/bridgefinder.db
DEFILLAMA_BASE_URL=https://bridges.llama.fi
LIFI_BASE_URL=https://li.quest
SYNC_INTERVAL_HOURS=8
REQUEST_TIMEOUT_SECONDS=5
LIFI_SYNC_TIMEOUT_SECONDS=30
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TIMEOUT_SECONDS=3
# Free Demo API key from https://www.coingecko.com/en/api — anonymous access
# to CoinGecko is heavily throttled and often blocked from cloud IPs, a Demo
# key gets a real documented rate limit. Optional: leave empty to fall back
# to anonymous access.
COINGECKO_API_KEY=
# Periodic check that every curated bridge URL is still reachable; admins
# (ADMIN_IDS) get a Telegram alert only when a bridge's status changes
# (healthy -> broken or broken -> healthy).
BRIDGE_HEALTH_CHECK_INTERVAL_HOURS=24
BRIDGE_HEALTH_CHECK_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
