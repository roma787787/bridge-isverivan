# Free Demo API key from https://www.coingecko.com/en/api — anonymous access
# to CoinGecko is heavily throttled and often blocked from cloud IPs, a Demo
# key gets a real documented rate limit. Optional: leave empty to fall back
# to anonymous access.
COINGECKO_API_KEY=
LOG_LEVEL=INFO
